# Dependabot keeps what this repository pins current:{% if .Ecosystems %} the app's own
# dependencies, which factory's lock updates don't cover (with Dependabot
# security updates on, the fix for a vulnerable one arrives as a pull
# request without waiting for the schedule), and{% end %} the actions and ClearCutt
# reusable workflows its workflows call. The ClearCutt pins
# (clearcutt-factory, -verify, -portal) are grouped so they move together;
# the image signer identity accepts any factory release tag (or commit), so
# a factory bump keeps images verifiable. Image inputs are factory's own:
# its lock updates re-resolve them. A new version is proposed once it is a
# week old (cooldown), so a release that is withdrawn soon after it was
# published never arrives; security updates don't wait.
version: 2
updates:
{% range .Ecosystems %}  - package-ecosystem: {% .Name %}
    directory: {% .Dir %}
    schedule:
      interval: weekly
    cooldown:
      default-days: 7
    groups:
      {% .Name %}:
        patterns: ["*"]
{% end %}{% if and .App (not .Ecosystems) %}  # The app's own dependencies: init found no manifest it knows (go.mod,
  # package.json, requirements.txt, …) next to app.yaml; add its ecosystem
  # here, as for github-actions below.
{% end %}  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
    cooldown:
      default-days: 7
    groups:
      clearcutt:
        patterns: ["northcutted/clearcutt-*"]
      actions:
        patterns: ["*"]
